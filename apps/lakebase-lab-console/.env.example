# Lakebase Lab Console — local development environment (example).
#
# Copy to `.env` for local runs. This file must contain NO secrets:
#   cp .env.example .env
#
# Authentication for local development uses your Databricks CLI profile
# (~/.databrickscfg) / default SDK auth — do NOT put tokens or client secrets
# in this file. When deployed as a Databricks App, identity and the Service
# Principal credentials are injected by the Apps runtime.

# Identity trust mode: "local" (dev, no proxy) or "apps" (deployed, fail closed).
# Leave unset locally; it auto-detects to "local". The deployed app.yaml sets "apps".
LAKEBASE_AUTH_MODE=local

# Local-only: route to a specific project/schema for the dev user.
LAKEBASE_USER_EMAIL=
LAKEBASE_PROJECT_ID=
LAKEBASE_SCHEMA=
LAKEBASE_BRANCH_ID=production

# Local Postgres connection (optional; used only in local mode).
PGHOST=
PGUSER=
PGDATABASE=databricks_postgres

# Comma-separated CORS origins allowed in local mode (Vite dev server).
LAKEBASE_DEV_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
